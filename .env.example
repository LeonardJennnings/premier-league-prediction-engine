# Copy this file to .env and fill in values. Never commit .env.
# Required by publish, settle, and the publish step of precompute.
# Fit reads the local match table and does not call football-data.org.
FOOTBALL_DATA_ORG_TOKEN=
LOG_LEVEL=INFO
# Comma-separated browser origins for the read-only Predictions API.
# Include Astro (Epic 5 web/) and any local Next preview ports you use.
API_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:3000
