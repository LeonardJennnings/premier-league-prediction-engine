---
import type { MatchGrade } from "../lib/ledger";
import type { MatchPrediction } from "../lib/types";
import { formatKickoff, pctLabel, resultLabel, secondaryMarketsLine } from "../lib/format";
import ProbabilityStrip from "./ProbabilityStrip.astro";

interface Props {
  match: MatchPrediction;
  settled?: boolean;
  grade?: MatchGrade | null;
  statusLabel?: string | null;
}

const { match, settled = false, grade = null, statusLabel = null } = Astro.props;
const secondary = secondaryMarketsLine(match);
---

<article class="match">
  <div class="fixture">
    <h3>{match.home_team} vs {match.away_team}</h3>
    <span class="kick nums">{formatKickoff(match.kickoff_utc)}</span>
  </div>

  {
    grade && (
      <div class="forecast">
        {grade.scoreText ? (
          <p class="score">
            Most likely score {grade.scoreText}
            <span class="nums"> ({grade.scorePct})</span>
          </p>
        ) : (
          <p class="score missing">No predicted score stored</p>
        )}
        {match.book_reconstructed_score && (
          <p class="result-line">
            Book reconstructed most likely score {match.book_reconstructed_score.home}-{match.book_reconstructed_score.away}
            <span class="nums"> ({pctLabel(match.book_reconstructed_score.probability)})</span>
          </p>
        )}
        {match.book_reconstructed_score?.label && (
          <p class="xg">{match.book_reconstructed_score.label}</p>
        )}
        <p class="result-line">
          Most likely result {grade.resultName}
          <span class="nums"> ({grade.resultPct})</span>
        </p>
        {grade.expectedGoals && (
          <p class="xg">Expected goals {grade.expectedGoals}</p>
        )}
        {grade.disagree && (
          <p class="disagree">
            The favourite score and the favourite result are not the same outcome.
          </p>
        )}
        {grade.omittedReason && <p class="xg">{grade.omittedReason}</p>}
      </div>
    )
  }

  <div class="strips">
    <ProbabilityStrip
      kind="model"
      home={match.p_home}
      draw={match.p_draw}
      away={match.p_away}
    />
    <ProbabilityStrip
      kind="book"
      home={match.book_p_home}
      draw={match.book_p_draw}
      away={match.book_p_away}
    />
  </div>

  <p class="secondary nums">{secondary}</p>

  {
    match.model_plus_market && (
      <p class="secondary">
        Model plus market
        <span class="nums">
          {" "}
          H {pctLabel(match.model_plus_market.p_home)} / D {pctLabel(match.model_plus_market.p_draw)} / A{" "}
          {pctLabel(match.model_plus_market.p_away)}
        </span>
        . This line uses the price available before kickoff. The line above is the pure model.
      </p>
    )
  }

  {
    (settled || statusLabel) && (
      <p class="settled">
        <span class="stamp">{statusLabel ?? "Settled"}</span>
        {grade?.actualText && (
          <>
            {" "}
            Actual {grade.actualText}
            {" / "}
            {resultLabel(match.result)}
          </>
        )}
        {grade?.exact === "hit" && " / Exact score hit"}
        {grade?.exact === "miss" && " / Exact score miss"}
        {grade?.exact === "not stored" && " / Exact score not stored"}
        {grade?.resultCall === "hit" && " / Result hit"}
        {grade?.resultCall === "miss" && " / Result miss"}
      </p>
    )
  }
</article>

<style>
  .match {
    padding: 14px 0;
    border-top: 1px solid var(--line-soft);
  }

  .match:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  .fixture {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .fixture h3 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .kick {
    font-size: 0.92rem;
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .forecast {
    margin: 0 0 10px;
  }

  .score {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .score.missing {
    font-size: 1.12rem;
    font-weight: 600;
  }

  .result-line,
  .xg,
  .disagree {
    margin: 4px 0 0;
    font-size: 0.92rem;
    color: var(--ink);
  }

  .disagree {
    color: var(--ink-soft);
  }

  .strips {
    display: grid;
    gap: 6px;
  }

  .secondary {
    margin: 8px 0 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .settled {
    margin: 8px 0 0;
    font-size: 0.92rem;
    color: var(--ink);
  }

  .stamp {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    padding: 2px 6px;
    border-radius: 2px;
    color: var(--ink-soft);
  }
</style>
