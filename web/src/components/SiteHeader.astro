---
interface Props {
  active: "weekend" | "past" | "how";
  subtitle?: string;
}

const { active, subtitle = "Public lab ledger" } = Astro.props;

const links = [
  { href: "/", id: "weekend", label: "Weekend" },
  { href: "/past", id: "past", label: "Past" },
  { href: "/how-it-works", id: "how", label: "Method" },
] as const;
---

<header class="top">
  <div class="brand">
    Premier League Prediction Engine
    <span>{subtitle}</span>
  </div>
  <nav class="meta" aria-label="Primary">
    {
      links.map((link, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> / </span>}
          <a
            href={link.href}
            aria-current={active === link.id ? "page" : undefined}
            class:list={[{ current: active === link.id }]}
          >
            {link.label}
          </a>
        </>
      ))
    }
  </nav>
</header>

<style>
  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .brand span {
    display: block;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  .meta {
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-align: right;
    white-space: nowrap;
  }

  .meta a {
    color: var(--ink);
    border-bottom: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 0;
  }

  .meta a.current {
    border-bottom-color: var(--ink);
    font-weight: 600;
  }

  .sep {
    color: var(--ink-soft);
  }

  @media (max-width: 480px) {
    .top {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .meta {
      text-align: left;
      white-space: normal;
    }
  }
</style>
