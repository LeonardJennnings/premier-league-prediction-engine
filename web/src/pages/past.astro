---
/**
 * Past scorecard from the committed ledger, grouped by matchday.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import MatchRow from "../components/MatchRow.astro";
import settledFile from "../data/ledger-settled.json";
import scorecardFile from "../data/ledger-scorecard.json";
import { pctLabel } from "../lib/format";
import {
  asPrediction,
  bothTeamsSummary,
  exactScoreSummary,
  flattenMatches,
  formatNat,
  gradeMatch,
  overUnderSummary,
  resultHitSummary,
  runningBookGap,
  type LedgerFile,
  type ScorecardFile,
} from "../lib/ledger";

const settled = settledFile as LedgerFile;
const card = scorecardFile as ScorecardFile;
const matches = flattenMatches(settled.matchdays);
const exact = exactScoreSummary(matches);
const results = resultHitSummary(matches);
const totals = overUnderSummary(matches);
const both = bothTeamsSummary(matches);
const running = runningBookGap(matches);
const range = card.book_comparison.range_95;

function statusLabel(status: string): string {
  if (status === "settled") return "Settled";
  if (status === "postponed") return "Postponed";
  if (status === "cancelled") return "Void";
  if (status === "pending") return "Pending";
  return status;
}
---

<BaseLayout
  title="Past scorecard — Premier League Prediction Engine"
  description="Settled Premier League matchdays, predicted against actual."
  active="past"
>
  <p class="lead">
    Settled matches, predicted against actual.
    <span class="sub">{card.note}</span>
  </p>

  <section aria-labelledby="counts-heading">
    <h2 class="section" id="counts-heading">Counts</h2>
    <ul class="tiles">
      <li><span class="num nums">{card.counts.settled}</span> settled</li>
      <li><span class="num nums">{card.counts.pending}</span> pending</li>
      <li><span class="num nums">{card.counts.postponed}</span> postponed</li>
      <li><span class="num nums">{card.counts.void}</span> void</li>
    </ul>
  </section>

  <section aria-labelledby="scores-heading">
    <h2 class="section" id="scores-heading">Scorecard</h2>
    <p class="explain">
      Log loss is lower when more probability sat on the outcome that happened. Every figure below names how many matches it uses. Postponed and void matches stay in the list and out of these averages.
    </p>
    <ul class="tiles">
      <li>
        <span class="num nums">{formatNat(card.home_draw_away.model_log_loss)}</span>
        home / draw / away log loss, {card.home_draw_away.match_count} matches
      </li>
      <li>
        <span class="num nums">{formatNat(card.book_comparison.gap_model_minus_closing)}</span>
        model minus closing book, {card.book_comparison.match_count} matches
        <span class="detail">
          Model {formatNat(card.book_comparison.model_log_loss)}, closing book {formatNat(card.book_comparison.closing_book_log_loss)}.
          {range && range.length === 2
            ? ` Range ${formatNat(range[0])} to ${formatNat(range[1])}.`
            : " No range until there are two matches."}
          {" "}Opening prices are not on this scorecard yet. League averages are not on this scorecard yet.
        </span>
      </li>
      <li>
        <span class="num nums">{formatNat(totals.model_log_loss)}</span>
        over / under 2.5 log loss, {totals.match_count} matches
        <span class="detail">
          Closing book {formatNat(totals.closing_book_log_loss)} on the same {totals.closing_book_match_count} matches.
          Opening prices and league averages are not on this scorecard yet.
        </span>
      </li>
      <li>
        <span class="num nums">{formatNat(both.model_log_loss)}</span>
        both teams to score, model only, {both.match_count} matches
      </li>
      <li>
        Scoreline log loss, 0 matches. These rows have no stored score table. The book's rebuilt table is not here, and league score frequencies are not here.
      </li>
      <li>
        <span class="num nums">{exact.hits}</span>
        exact-score hits, {exact.match_count} matches
        <span class="detail">
          Always 1-1 would have hit {exact.always_1_1_hits} of the same {exact.match_count}.
          Average probability printed: {exact.mean_printed_probability == null ? "not available" : pctLabel(exact.mean_printed_probability)}.
          {exact.match_count === 0 && " Matchday 11 has no stored predicted score, so it is not in this count."}
        </span>
      </li>
      <li>
        <span class="num nums">{results.hits}</span>
        correct result, {results.match_count} matches
        <span class="detail">
          Average probability of that top result: {results.mean_top_probability == null ? "not available" : pctLabel(results.mean_top_probability)}.
        </span>
      </li>
      <li>
        <span class="num nums">{formatNat(card.goal_error.mean_absolute_error)}</span>
        goal error, {card.goal_error.match_count} matches
        {card.goal_error.match_count === 0 && (
          <span class="detail">Expected goals were not stored on these rows.</span>
        )}
      </li>
      <li>
        Running gap to the closing book, never restarted
        <span class="detail">
          {running.length === 0
            ? "No settled match has a closing price yet."
            : running
                .map(
                  (point) =>
                    `After matchday ${point.matchday}: ${formatNat(point.gap)} over ${point.match_count} matches.`,
                )
                .join(" ")}
        </span>
      </li>
    </ul>
  </section>

  {
    settled.matchdays.map((day) => (
      <section class="slate" aria-labelledby={`md-${day.matchday}`}>
        <h2 class="section" id={`md-${day.matchday}`}>
          <a href={`/past/${day.matchday}`}>Matchday {day.matchday}</a>
          <span class="count"> — {day.matches.length} matches</span>
        </h2>
        {day.matches.map((match) => (
          <MatchRow
            match={asPrediction(match)}
            grade={gradeMatch(match)}
            settled={match.status === "settled"}
            statusLabel={statusLabel(match.status)}
          />
        ))}
      </section>
    ))
  }
</BaseLayout>

<style>
  .tiles {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .tiles li {
    border-top: 1px solid var(--line-soft);
    padding-top: 10px;
    font-size: 1.02rem;
  }
  .num {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .detail {
    display: block;
    margin-top: 4px;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .explain {
    margin: -6px 0 14px;
    font-size: 0.92rem;
    color: var(--ink);
    max-width: 40em;
  }
  .slate {
    margin-bottom: 28px;
  }
  .count {
    font-weight: 400;
    color: var(--ink-soft);
    text-transform: none;
    letter-spacing: 0;
  }
  h2.section a {
    border-bottom: none;
    color: inherit;
  }
</style>
