---
/**
 * Past scorecard index — immutable weeks from Epic 4.
 * Version C peeks (counted stats + waffle) live here after the week list / detail.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import MatchRow from "../components/MatchRow.astro";
import HitMissWaffle from "../components/HitMissWaffle";
import CountedStat from "../components/CountedStat";
import OutcomeBucketTable from "../components/OutcomeBucketTable";
import CalibrationChart from "../components/CalibrationChart";
import { fetchWeek, fetchWeeks, getApiBase } from "../lib/api";
import { SAMPLE_UPCOMING, SAMPLE_WAFFLE } from "../lib/sample";
import { topOneXTwo } from "../lib/format";
import type { MatchPrediction } from "../lib/types";

const apiBase = getApiBase();
const weeksResult = await fetchWeeks();

let notice: string | null = null;
let modelVersion = "sample-local";
let weeks: { iso_week: string; match_count: number }[] = [];
let detailMatches: MatchPrediction[] = [];
let selectedWeek: string | null = null;
let waffleCells = SAMPLE_WAFFLE;

if (!weeksResult.ok) {
  notice =
    weeksResult.status === 0
      ? `API unreachable at ${apiBase}. Showing sample peeks.`
      : `API ${weeksResult.status}: ${weeksResult.detail}. Showing sample peeks.`;
  detailMatches = SAMPLE_UPCOMING.map((m, i) => ({
    ...m,
    status: "settled",
    home_goals: i % 3 === 0 ? 1 : 2,
    away_goals: i % 2,
    result: (["H", "D", "A", "H"] as const)[i],
    settled_at: "2026-11-10T22:00:00Z",
  }));
  selectedWeek = "sample";
} else {
  modelVersion = weeksResult.data.model_version;
  weeks = weeksResult.data.weeks;
  if (weeks.length === 0) {
    notice = "No settled weeks yet. Showing sample peeks.";
    detailMatches = SAMPLE_UPCOMING.map((m, i) => ({
      ...m,
      status: "settled",
      home_goals: i % 3 === 0 ? 1 : 2,
      away_goals: i % 2,
      result: (["H", "D", "A", "H"] as const)[i],
      settled_at: "2026-11-10T22:00:00Z",
    }));
    selectedWeek = "sample";
  } else {
    selectedWeek = weeks[0].iso_week;
    const weekResult = await fetchWeek(selectedWeek);
    if (weekResult.ok) {
      detailMatches = weekResult.data.matches;
      // Lightweight shell binding — DS owns production hit/miss + metrics.
      waffleCells = detailMatches.map((m) => {
        if (!m.result) return false;
        return topOneXTwo(m.p_home, m.p_draw, m.p_away) === m.result;
      });
    } else {
      notice = `Could not load ${selectedWeek}: ${weekResult.detail}`;
    }
  }
}

const hits = waffleCells.filter(Boolean).length;
---

<BaseLayout
  title="Past scorecard — Premier League Prediction Engine"
  description="Settled Premier League weekends — misses stay visible."
  active="past"
>
  <p class="lead">
    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer at nisl vitae arcu tincidunt.
    <span class="lorem">Past weekends stay as published. Misses stay visible.</span>
  </p>

  {notice && (
    <p class="notice" role="status">
      <strong>Note.</strong> {notice}
    </p>
  )}

  <section aria-labelledby="weeks-heading">
    <h2 class="section" id="weeks-heading">Settled weeks</h2>
    {
      weeks.length > 0 ? (
        <ul class="week-list">
          {weeks.map((w) => (
            <li>
              <a href={`/past/${w.iso_week}`}>
                {w.iso_week}
                <span class="nums"> — {w.match_count} matches</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No ISO weeks from the API yet.</p>
      )
    }
  </section>

  {
    selectedWeek && (
      <section class="slate" aria-labelledby="detail-heading">
        <h2 class="section" id="detail-heading">
          {selectedWeek === "sample" ? "Sample week" : `Latest — ${selectedWeek}`}
        </h2>
        <p class="meta-line nums">
          Model <code>{modelVersion}</code>
        </p>
        {detailMatches.map((m) => (
          <MatchRow match={m} settled />
        ))}
      </section>
    )
  }

  <section class="peeks" aria-label="Past peeks">
    <div class="peek">
      <h2 class="section">Past / hit vs miss</h2>
      <div class="counted">
        <CountedStat client:load value={String(hits)} label={`hits / ${waffleCells.length} settled`} />
        {/* TODO(Data Scientist): real mean Brier / log-loss from walk-forward */}
        <CountedStat client:load value="0.198" label="mean Brier (1X2) — placeholder" />
      </div>
      <HitMissWaffle client:load cells={waffleCells} />
    </div>
    <div class="peek">
      <h2 class="section">Calibration peek</h2>
      <CalibrationChart client:load />
      <div class="bucket-wrap">
        <OutcomeBucketTable client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .week-list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
  }
  .week-list li {
    border-top: 1px solid var(--line-soft);
    padding: 10px 0;
  }
  .week-list li:last-child {
    border-bottom: 1px solid var(--line-soft);
  }
  .week-list a {
    display: block;
    font-weight: 600;
    border-bottom: none;
    min-height: 44px;
    line-height: 44px;
  }
  .week-list span {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .empty {
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .meta-line {
    margin: -6px 0 12px;
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  .meta-line code {
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .slate {
    margin-bottom: 28px;
  }
  .peeks {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 22px;
    margin-bottom: 24px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
  .counted {
    display: flex;
    gap: 20px;
    margin-bottom: 14px;
  }
  .bucket-wrap {
    margin-top: 16px;
  }
  @media (max-width: 640px) {
    .peeks {
      grid-template-columns: 1fr;
    }
  }
</style>
