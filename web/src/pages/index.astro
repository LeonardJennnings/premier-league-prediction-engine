---
/**
 * This weekend, from the committed ledger. No API and no sample rows.
 * Sample fixtures appear only when PUBLIC_SHOW_SAMPLE is exactly "1".
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import MatchRow from "../components/MatchRow.astro";
import upcomingFile from "../data/ledger-upcoming.json";
import { SAMPLE_UPCOMING } from "../lib/sample";
import {
  asPrediction,
  gradeMatch,
  sampleAllowed,
  visibleUpcoming,
  type LedgerFile,
} from "../lib/ledger";

const showSample = sampleAllowed(import.meta.env.PUBLIC_SHOW_SAMPLE);
const days = visibleUpcoming(upcomingFile as LedgerFile, Date.now());
const usingSample = showSample && days.length === 0;
---

<BaseLayout title="This weekend — Premier League Prediction Engine" active="weekend">
  <p class="lead">
    Most likely score, most likely result, and expected goals for matches still to kick off. The model is the headline. The book sits beside it when a line exists.
    <span class="sub">The favourite score and the favourite result can disagree. These numbers were stored before kickoff.</span>
  </p>

  {
    usingSample && (
      <p class="notice" role="status">
        <strong>Note.</strong> Sample fixtures, shown only because PUBLIC_SHOW_SAMPLE is set. This is not the ledger.
      </p>
    )
  }

  {
    usingSample
      ? (
          <section class="slate" aria-labelledby="weekend-heading">
            <h2 class="section" id="weekend-heading">Sample</h2>
            {SAMPLE_UPCOMING.map((match) => (
              <MatchRow match={match} />
            ))}
          </section>
        )
      : days.length === 0
        ? <p class="empty">No matches still to kick off.</p>
        : days.map((day) => (
            <section class="slate" aria-labelledby={`md-${day.matchday}`}>
              <h2 class="section" id={`md-${day.matchday}`}>
                Matchday {day.matchday}
              </h2>
              {day.matches.map((match) => (
                <MatchRow match={asPrediction(match)} grade={gradeMatch(match)} />
              ))}
            </section>
          ))
  }
</BaseLayout>

<style>
  .slate {
    margin-bottom: 28px;
  }
  .empty {
    font-size: 1.02rem;
    color: var(--ink-soft);
  }
</style>
