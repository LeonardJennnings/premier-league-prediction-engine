---
/**
 * Weekend slate.
 * Preference: live API rows still to kick off → committed snapshot rows still
 * to kick off → labelled sample. A real snapshot that has fully kicked off
 * stays empty rather than swapping in sample fixtures.
 * LiveWeekend refreshes from the API after hydrate when reachable.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveWeekend from "../components/LiveWeekend";
import { fetchUpcoming, getApiBase } from "../lib/api";
import { SAMPLE_UPCOMING } from "../lib/sample";
import { chooseWeekendSlate } from "../lib/slate";
import { UPCOMING_SNAPSHOT, hasUpcomingSnapshot } from "../lib/snapshot";

const apiBase = getApiBase();
const result = await fetchUpcoming();
const slate = chooseWeekendSlate({
  nowMs: Date.now(),
  apiBase,
  live: result.ok
    ? {
        ok: true,
        modelVersion: result.data.model_version,
        matches: result.data.matches,
      }
    : { ok: false, status: result.status, detail: result.detail },
  snapshot: hasUpcomingSnapshot()
    ? {
        modelVersion: UPCOMING_SNAPSHOT.model_version,
        matches: UPCOMING_SNAPSHOT.matches,
      }
    : null,
  sampleMatches: SAMPLE_UPCOMING,
});
---

<BaseLayout title="This weekend — Premier League Prediction Engine" active="weekend">
  <p class="lead">
    Home, draw, and away probabilities for Premier League matches still to kick off, with the book beside the model when a line exists.
    <span class="sub">Numbers are stored before kickoff. Misses stay on the past scorecard.</span>
  </p>

  <section class="slate" aria-labelledby="weekend-heading">
    <h2 class="section" id="weekend-heading">This weekend</h2>
    <LiveWeekend
      client:load
      apiBase={apiBase}
      initialMatches={slate.matches}
      initialModelVersion={slate.modelVersion}
      initialNotice={slate.notice}
    />
  </section>
</BaseLayout>

<style>
  .slate {
    margin-bottom: 24px;
  }
</style>
